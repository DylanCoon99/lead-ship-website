---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-950 text-white/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-accent rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
          <span class="text-xl font-bold text-white">Lead Ship</span>
        </a>
        <p class="text-sm leading-relaxed">
          The AI-powered marketing operations platform for B2B demand generation.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="/features" class="text-sm hover:text-white transition-colors">Features</a></li>
          <li><a href="/pricing" class="text-sm hover:text-white transition-colors">Pricing</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="text-sm hover:text-white transition-colors">About</a></li>
          <li><a href="/contact" class="text-sm hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Legal</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="text-sm hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 text-center text-sm">
      <p>&copy; {currentYear} Lead Ship. All rights reserved.</p>
    </div>
  </div>
</footer>
