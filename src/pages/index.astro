---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lead Ship — B2B Lead Delivery Platform">

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <!-- Gradient orb -->
    <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          Every Lead Delivered.<br/>
          <span class="text-accent-light">Every Campaign on Track.</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-white/70 leading-relaxed max-w-2xl">
          Lead Ship is the lead delivery platform that helps B2B campaign managers collect, validate, and deliver leads to buyers — automatically, on schedule, at scale.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-lg transition-colors text-base">
            Request a Demo
          </a>
          <a href="/features" class="inline-flex items-center justify-center border border-white/20 hover:border-white/40 text-white font-semibold px-8 py-3.5 rounded-lg transition-colors text-base">
            See How It Works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How It Works</h2>
        <p class="mt-4 text-lg text-gray-500">Three steps from campaign setup to delivered leads.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 stagger">
        <!-- Step 1 -->
        <div class="fade-up relative p-8 rounded-2xl bg-surface border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <span class="text-accent font-bold text-lg">1</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Define Your Campaign</h3>
          <p class="text-gray-500 leading-relaxed">
            Set targeting criteria — industry, title, geography, company size, ABM lists. Configure pacing, delivery schedule, and suppression rules.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="fade-up relative p-8 rounded-2xl bg-surface border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <span class="text-accent font-bold text-lg">2</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Suppliers Upload & We Validate</h3>
          <p class="text-gray-500 leading-relaxed">
            Leads are auto-checked for duplicates, matched against suppression lists, and validated against your targeting specs before a single record moves forward.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="fade-up relative p-8 rounded-2xl bg-surface border border-gray-100">
          <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-6">
            <span class="text-accent font-bold text-lg">3</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Leads Delivered on Autopilot</h3>
          <p class="text-gray-500 leading-relaxed">
            Approved leads are delivered to buyers on your schedule via email, API, or cloud storage — with full audit trails and retry logic built in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Built For Every Role -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Built For Every Role</h2>
        <p class="mt-4 text-lg text-gray-500">Whether you manage campaigns, supply leads, or buy them — Lead Ship works for you.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger">
        <!-- Campaign Managers -->
        <div class="fade-up bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Campaign Managers</h3>
          <p class="text-gray-500 leading-relaxed">
            Create campaigns with precision targeting. Manage supplier assignments, approve batches, track fulfillment, and control pacing — all from one dashboard.
          </p>
        </div>

        <!-- Suppliers -->
        <div class="fade-up bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Suppliers</h3>
          <p class="text-gray-500 leading-relaxed">
            Upload leads in bulk, map CSV fields, and track batch status. Get notified when targeting changes or new campaigns are assigned to you.
          </p>
        </div>

        <!-- Buyers -->
        <div class="fade-up bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Buyers</h3>
          <p class="text-gray-500 leading-relaxed">
            Receive validated, deduplicated leads on your schedule. Choose your delivery channel — email, API webhook, or cloud storage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12 stagger">
        <div class="fade-up text-center">
          <div class="stat-number text-4xl lg:text-5xl font-extrabold text-white" data-target="50000" data-suffix="+">0</div>
          <p class="mt-2 text-white/50 text-sm font-medium">Leads Delivered</p>
        </div>
        <div class="fade-up text-center">
          <div class="stat-number text-4xl lg:text-5xl font-extrabold text-white" data-target="200" data-suffix="+">0</div>
          <p class="mt-2 text-white/50 text-sm font-medium">Campaigns Managed</p>
        </div>
        <div class="fade-up text-center">
          <div class="stat-number text-4xl lg:text-5xl font-extrabold text-white" data-target="99" data-suffix="%">0</div>
          <p class="mt-2 text-white/50 text-sm font-medium">Delivery Success Rate</p>
        </div>
        <div class="fade-up text-center">
          <div class="stat-number text-4xl lg:text-5xl font-extrabold text-white" data-target="120" data-suffix="+">0</div>
          <p class="mt-2 text-white/50 text-sm font-medium">Hours Saved Monthly</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Accordion -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Powerful Features, Simple Interface</h2>
        <p class="mt-4 text-lg text-gray-500">Everything you need to manage leads at scale — nothing you don't.</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4" id="feature-accordion">
        <!-- Item 1 -->
        <div class="feature-item border border-gray-200 rounded-xl overflow-hidden">
          <button class="feature-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors" data-index="0">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z" />
                </svg>
              </div>
              <span class="text-lg font-semibold text-gray-900">Precision Targeting</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 transition-transform accordion-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="feature-content hidden px-6 pb-6">
            <p class="text-gray-500 leading-relaxed pl-14">
              Define exactly who you want to reach with ABM company lists, ICP filters, industry and job title targeting, geographic criteria, and company size parameters. Set percentage-based allocation across segments and NAICS codes for granular control.
            </p>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="feature-item border border-gray-200 rounded-xl overflow-hidden">
          <button class="feature-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors" data-index="1">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-emerald-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              </div>
              <span class="text-lg font-semibold text-gray-900">Automated Validation</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 transition-transform accordion-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="feature-content hidden px-6 pb-6">
            <p class="text-gray-500 leading-relaxed pl-14">
              Every lead is automatically deduplicated, checked against suppression lists using secure hash matching, and validated against campaign targeting criteria. Pacing enforcement ensures you never exceed weekly or monthly delivery limits.
            </p>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="feature-item border border-gray-200 rounded-xl overflow-hidden">
          <button class="feature-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors" data-index="2">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
              </div>
              <span class="text-lg font-semibold text-gray-900">Flexible Delivery</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 transition-transform accordion-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="feature-content hidden px-6 pb-6">
            <p class="text-gray-500 leading-relaxed pl-14">
              Deliver leads via email with CSV attachments, push to buyer systems through API webhooks, or drop files in cloud storage. Schedule deliveries by day, time, and timezone with built-in retry logic and full audit trails.
            </p>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="feature-item border border-gray-200 rounded-xl overflow-hidden">
          <button class="feature-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors" data-index="3">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-amber-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                </svg>
              </div>
              <span class="text-lg font-semibold text-gray-900">Quote & Pricing Workflows</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 transition-transform accordion-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="feature-content hidden px-6 pb-6">
            <p class="text-gray-500 leading-relaxed pl-14">
              Send RFQs to multiple suppliers, collect and compare bids by price, volume, and timeline. Select winners and convert approved quotes directly into live campaigns — no re-entry required.
            </p>
          </div>
        </div>

        <!-- Item 5 -->
        <div class="feature-item border border-gray-200 rounded-xl overflow-hidden">
          <button class="feature-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors" data-index="4">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-rose-50 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
              </div>
              <span class="text-lg font-semibold text-gray-900">Real-Time Reporting</span>
            </div>
            <svg class="w-5 h-5 text-gray-400 transition-transform accordion-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="feature-content hidden px-6 pb-6">
            <p class="text-gray-500 leading-relaxed pl-14">
              Track active campaigns, pending deliveries, and fulfillment rates from a live dashboard. Drill into assignee performance, spend by buyer, and cost-per-lead analysis. Export any report to CSV or Excel.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <svg class="w-12 h-12 text-accent/20 mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" />
      </svg>
      <blockquote class="text-2xl sm:text-3xl font-medium text-gray-900 leading-snug">
        "Lead Ship transformed how we manage our campaigns. What used to take hours of spreadsheet work now runs on autopilot."
      </blockquote>
      <div class="mt-8">
        <div class="w-12 h-12 bg-gray-200 rounded-full mx-auto mb-3"></div>
        <p class="font-semibold text-gray-900">Your Name Here</p>
        <p class="text-gray-500 text-sm">Campaign Manager, Your Company</p>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Ready to automate your lead delivery?</h2>
      <p class="mt-4 text-lg text-white/60">Get started with Lead Ship and stop managing leads manually.</p>
      <div class="mt-8">
        <a href="/contact" class="inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-lg transition-colors text-base">
          Request a Demo
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Accordion logic
  document.querySelectorAll('.feature-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.feature-item');
      const content = item?.querySelector('.feature-content');
      const chevron = btn.querySelector('.accordion-chevron');
      const isOpen = !content?.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.feature-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.accordion-chevron').forEach(c => c.classList.remove('rotate-180'));

      // Toggle current
      if (!isOpen) {
        content?.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>
