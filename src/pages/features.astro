---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Features — Lead Ship" description="Explore Lead Ship's AI-powered marketing operations features: campaign management, TrueModel™ validation, automated delivery, quoting, reporting, and enterprise security.">

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Everything You Need to Run Marketing Operations at Scale</h1>
      <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">
        From campaign request to delivery to billing — Lead Ship's AI-powered platform handles the complexity so you can focus on results.
      </p>
    </div>
  </section>

  <!-- Feature 1: Campaign Management -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="fade-up">
          <div class="inline-flex items-center gap-2 bg-accent/10 text-accent text-sm font-semibold px-3 py-1 rounded-full mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z" />
            </svg>
            Campaign Management
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Build Campaigns With Precision</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Multi-criteria targeting: industry, job title, geography, company size, NAICS codes</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">ABM and ICP targeting modes with percentage-based allocation</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Custom questions and flexible CSV field configuration</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Pacing controls — weekly or monthly limits with tolerance thresholds</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Full campaign lifecycle management: draft, active, paused, closed</span>
            </li>
          </ul>
        </div>
        <div class="fade-up rounded-2xl overflow-hidden border border-gray-100 aspect-[4/3]">
          <img src="/images/photosforsite/Build Campaigns With Precision section v1.png" alt="Campaign management interface showing multi-criteria targeting" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 2: Supplier & Lead Operations -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="fade-up rounded-2xl overflow-hidden border border-gray-100 aspect-[4/3] lg:order-first order-last">
          <img src="/images/photosforsite/Collect Leads Without the Manual Work v1.png" alt="Supplier and lead operations interface with bulk CSV upload" class="w-full h-full object-cover" />
        </div>
        <div class="fade-up">
          <div class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            Supplier & Lead Operations
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Collect Leads Without the Manual Work</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Onboard suppliers and assign them to campaigns with lead allocation</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Bulk CSV upload with intelligent column mapping</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Automated deduplication, suppression list checks, and ABM distribution enforcement</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Batch approval workflows — nothing ships without sign-off</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Lead-level encryption for sensitive contact data</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 3: Automated Delivery -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="fade-up">
          <div class="inline-flex items-center gap-2 bg-purple-50 text-purple-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            Automated Delivery
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Deliver Leads on Schedule, Every Time</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Set delivery day, time, and timezone per campaign</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Three delivery channels: email CSV, API webhook, cloud storage</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Built-in retry logic with error tracking and status monitoring</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Complete delivery history and audit trail for every lead</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Optional approval gates before any delivery goes out</span>
            </li>
          </ul>
        </div>
        <div class="fade-up rounded-2xl overflow-hidden border border-gray-100 aspect-[4/3]">
          <img src="/images/photosforsite/Deliver Leads on Schedule, Every Time.png" alt="Automated delivery interface with scheduling controls" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 4: Quoting -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="fade-up rounded-2xl overflow-hidden border border-gray-100 aspect-[4/3] lg:order-first order-last">
          <img src="/images/photosforsite/Streamline Supplier Pricing v1.png" alt="Quote and pricing interface with supplier bid comparison" class="w-full h-full object-cover" />
        </div>
        <div class="fade-up">
          <div class="inline-flex items-center gap-2 bg-amber-50 text-amber-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
            </svg>
            Quote & Pricing
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Streamline Supplier Pricing</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Create RFQs with full targeting specifications</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Assign multiple suppliers and collect pricing responses</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Compare bids by price, volume, and timeline side-by-side</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Convert winning quotes directly into live campaigns</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 5: Reporting -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="fade-up">
          <div class="inline-flex items-center gap-2 bg-rose-50 text-rose-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
            Reporting & Analytics
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">See What's Working — and What Isn't</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-rose-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Real-time dashboard with active campaigns, pending deliveries, and weekly lead counts</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-rose-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Assignee performance tracking with fulfillment rates</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-rose-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Spend summary by buyer with cost-per-lead analysis</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-rose-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-gray-600">Export any report to CSV or Excel with one click</span>
            </li>
          </ul>
        </div>
        <div class="fade-up rounded-2xl overflow-hidden border border-gray-100 aspect-[4/3]">
          <img src="/images/photosforsite/See What's Working- and What Isn't v1.png" alt="Reporting dashboard with campaign analytics and performance metrics" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 6: Security -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 fade-up">
        <div class="inline-flex items-center gap-2 bg-navy-800/10 text-navy-700 text-sm font-semibold px-3 py-1 rounded-full mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          Security & Compliance
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Enterprise-Grade Security, Built In</h2>
        <p class="mt-4 text-lg text-gray-500">Your lead data is protected at every step of the pipeline.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
        <div class="fade-up bg-white p-6 rounded-xl border border-gray-100">
          <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">AES Encryption at Rest</h3>
          <p class="text-gray-500 text-sm">Lead emails and phone numbers encrypted via AWS KMS with wrapped data encryption keys.</p>
        </div>
        <div class="fade-up bg-white p-6 rounded-xl border border-gray-100">
          <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Hash-Based Suppression</h3>
          <p class="text-gray-500 text-sm">Suppression lists use hashed matching — no PII is ever exposed in suppression checks.</p>
        </div>
        <div class="fade-up bg-white p-6 rounded-xl border border-gray-100">
          <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Multi-Tenant Isolation</h3>
          <p class="text-gray-500 text-sm">Complete data isolation between tenants with tenant-scoped queries on every request.</p>
        </div>
