---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing — Lead Ship" description="Simple, transparent pricing that scales with your lead volume. No hidden fees.">

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Simple, Transparent Pricing</h1>
      <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">
        Plans that scale with your lead volume. No hidden fees.
      </p>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto stagger">

        <!-- Starter -->
        <div class="fade-up bg-white rounded-2xl border border-gray-200 p-8 flex flex-col">
          <div class="mb-6">
            <h3 class="text-lg font-bold text-gray-900">Starter</h3>
            <p class="text-sm text-gray-500 mt-1">For small teams getting started</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-extrabold text-gray-900">$299</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 5 active campaigns</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 5,000 leads/month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Email delivery</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 3 suppliers</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Basic reporting</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Email support</span>
            </li>
          </ul>
          <a href="/contact" class="w-full text-center border-2 border-accent text-accent hover:bg-accent hover:text-white font-semibold py-3 rounded-lg transition-colors text-sm">
            Get Started
          </a>
        </div>

        <!-- Growth (Featured) -->
        <div class="fade-up bg-white rounded-2xl border-2 border-accent p-8 flex flex-col relative shadow-lg shadow-accent/10">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-accent text-white text-xs font-bold px-4 py-1 rounded-full">
            Most Popular
          </div>
          <div class="mb-6">
            <h3 class="text-lg font-bold text-gray-900">Growth</h3>
            <p class="text-sm text-gray-500 mt-1">For growing operations</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-extrabold text-gray-900">$799</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 25 active campaigns</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 25,000 leads/month</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Email + API delivery</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Up to 10 suppliers</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Advanced reporting & exports</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Suppression lists</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Quote management</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Priority support</span>
            </li>
          </ul>
          <a href="/contact" class="w-full text-center bg-accent hover:bg-accent-dark text-white font-semibold py-3 rounded-lg transition-colors text-sm">
            Get Started
          </a>
        </div>

        <!-- Enterprise -->
        <div class="fade-up bg-white rounded-2xl border border-gray-200 p-8 flex flex-col">
          <div class="mb-6">
            <h3 class="text-lg font-bold text-gray-900">Enterprise</h3>
            <p class="text-sm text-gray-500 mt-1">For large-scale lead programs</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-extrabold text-gray-900">Custom</span>
          </div>
          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Unlimited campaigns</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Unlimited leads</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">All delivery channels</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Unlimited suppliers</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Custom reporting & SLA</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">Dedicated account manager</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              <span class="text-gray-600 text-sm">SSO + custom integrations</span>
            </li>
          </ul>
          <a href="/contact" class="w-full text-center border-2 border-accent text-accent hover:bg-accent hover:text-white font-semibold py-3 rounded-lg transition-colors text-sm">
            Contact Sales
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-surface">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">Frequently Asked Questions</h2>

      <div class="space-y-4" id="faq-accordion">
        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">Can I change plans later?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">Yes. You can upgrade or downgrade your plan at any time. Changes take effect at the start of your next billing cycle.</p>
          </div>
        </div>

        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">What counts as a lead?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">A lead is any individual contact record that passes validation and is delivered to a buyer. Rejected or deduplicated leads do not count toward your monthly limit.</p>
          </div>
        </div>

        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">Do you offer annual billing?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">Yes. Annual billing is available at a 20% discount compared to monthly pricing. Contact us for details.</p>
          </div>
        </div>

        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">What delivery methods are included?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">The Starter plan includes email delivery (CSV attachments). Growth adds API webhook delivery. Enterprise includes all channels: email, API, and cloud storage integration.</p>
          </div>
        </div>

        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">Is there a free trial?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">We offer a 14-day free trial on the Growth plan so you can explore the full platform before committing. No credit card required to start.</p>
          </div>
        </div>

        <div class="faq-item bg-white rounded-xl border border-gray-200 overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-gray-50 transition-colors">
            <span class="font-semibold text-gray-900">What happens if I exceed my lead limit?</span>
            <svg class="w-5 h-5 text-gray-400 transition-transform faq-chevron shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="faq-content hidden px-6 pb-6">
            <p class="text-gray-500">We'll notify you when you're approaching your limit. You can upgrade mid-cycle, or we can discuss overage pricing. We never cut off delivery without warning.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-24 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">Not sure which plan is right?</h2>
      <p class="mt-4 text-lg text-white/60">Talk to us and we'll help you find the best fit for your team.</p>
      <div class="mt-8">
        <a href="/contact" class="inline-flex items-center justify-center bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-lg transition-colors text-base">
          Request a Demo
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const content = item?.querySelector('.faq-content');
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = !content?.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('rotate-180'));

      if (!isOpen) {
        content?.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });
</script>
