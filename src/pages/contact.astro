---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Lead Ship" description="Request a demo of Lead Ship or get in touch with our team.">

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Get in Touch</h1>
      <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">
        Request a demo, ask a question, or just say hello. We'll get back to you within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20">

        <!-- Calendly Widget -->
        <div class="lg:col-span-3 fade-up">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Schedule a Demo</h2>
          <div class="calendly-inline-widget" data-url="https://calendly.com/mcoon-lead-ship/30min?primary_color=2563eb" style="min-width:320px;height:700px;"></div>
          <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
        </div>

        <!-- Contact Info -->
        <div class="lg:col-span-2 fade-up">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Contact Info</h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-2">Email</h3>
              <a href="mailto:hello@lead-ship.com" class="text-accent hover:text-accent-dark transition-colors">
                hello@lead-ship.com
              </a>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-2">Response Time</h3>
              <p class="text-gray-500 text-sm">We typically respond within 24 hours on business days.</p>
            </div>

            <div class="bg-surface rounded-xl p-6 border border-gray-100">
              <h3 class="text-sm font-semibold text-gray-900 mb-3">What to expect</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">1</span>
                  </div>
                  <span class="text-gray-500 text-sm">Pick a 30-minute slot that works for you</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">2</span>
                  </div>
                  <span class="text-gray-500 text-sm">You'll receive a calendar invite with a meeting link</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">3</span>
                  </div>
                  <span class="text-gray-500 text-sm">Get a personalized demo tailored to your workflow</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

