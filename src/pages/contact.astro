---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Lead Ship" description="Request a demo of Lead Ship or get in touch with our team.">

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Get in Touch</h1>
      <p class="mt-6 text-lg text-white/60 max-w-2xl mx-auto">
        Request a demo, ask a question, or just say hello. We'll get back to you within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20">

        <!-- Form -->
        <div class="lg:col-span-3 fade-up">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Request a Demo</h2>
          <form id="contact-form" class="space-y-6" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-700 mb-2">First name</label>
                <input type="text" name="first-name" id="first-name" required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-700 mb-2">Last name</label>
                <input type="text" name="last-name" id="last-name" required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Work email</label>
              <input type="email" name="email" id="email" required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm" />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 mb-2">Company name</label>
              <input type="text" name="company" id="company"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm" />
            </div>

            <div>
              <label for="lead-volume" class="block text-sm font-medium text-gray-700 mb-2">Monthly lead volume</label>
              <select name="lead-volume" id="lead-volume"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm bg-white">
                <option value="">Select a range</option>
                <option value="under-1000">Under 1,000</option>
                <option value="1000-5000">1,000 – 5,000</option>
                <option value="5000-25000">5,000 – 25,000</option>
                <option value="25000-100000">25,000 – 100,000</option>
                <option value="100000+">100,000+</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message <span class="text-gray-400">(optional)</span></label>
              <textarea name="message" id="message" rows="4"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors text-sm resize-none"></textarea>
            </div>

            <button type="submit" id="submit-btn"
              class="w-full sm:w-auto bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-3.5 rounded-lg transition-colors text-sm">
              Request a Demo
            </button>

            <div id="form-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg p-4 text-sm">
              Thanks for reaching out! We'll be in touch within 24 hours.
            </div>

            <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 text-sm">
              Something went wrong. Please try again or email us directly.
            </div>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="lg:col-span-2 fade-up">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Contact Info</h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-2">Email</h3>
              <a href="mailto:hello@lead-ship.com" class="text-accent hover:text-accent-dark transition-colors">
                hello@lead-ship.com
              </a>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-2">Response Time</h3>
              <p class="text-gray-500 text-sm">We typically respond within 24 hours on business days.</p>
            </div>

            <div class="bg-surface rounded-xl p-6 border border-gray-100">
              <h3 class="text-sm font-semibold text-gray-900 mb-3">What to expect</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">1</span>
                  </div>
                  <span class="text-gray-500 text-sm">We'll confirm your demo request within 24 hours</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">2</span>
                  </div>
                  <span class="text-gray-500 text-sm">Schedule a 30-minute walkthrough at your convenience</span>
                </li>
                <li class="flex items-start gap-3">
                  <div class="w-6 h-6 bg-accent/10 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-accent text-xs font-bold">3</span>
                  </div>
                  <span class="text-gray-500 text-sm">Get a personalized demo tailored to your workflow</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !successMsg || !errorMsg) return;

    submitBtn.textContent = 'Sending...';
    submitBtn.setAttribute('disabled', 'true');
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.textContent = 'Request a Demo';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
